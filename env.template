# Variables obligatorias
# Postgres local con Docker (docker-compose.yml): pnpm db:up
# Tambien acepta una URL de Prisma Accelerate (prisma:// o prisma+postgres://).
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/gym_app?schema=public"
AUTH_SESSION_SECRET="reemplazar-por-una-clave-larga-y-segura"

# Opcional: conexion DIRECTA a produccion (no la de Accelerate). Solo la usa
# `pnpm db:pull-prod`, que copia produccion a la base local.
PROD_DATABASE_URL=""

# Fallback opcional para compatibilidad con entornos viejos
AUTH_SECRET=""

# Requerida solo si vas a subir media del dataset a Cloudinary
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Opcional: carpeta raiz usada por el script upload:exercise-media
CLOUDINARY_ASSET_FOLDER_ROOT="exercises"

# Opcional: base publica para resolver media local si no usas Cloudinary
EXERCISE_MEDIA_PUBLIC_BASE_PATH="/exercises-dataset"
